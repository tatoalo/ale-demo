# PostHog project API token (public, safe in client code) and ingestion host
POSTHOG_API_KEY=phc_your_project_token
POSTHOG_HOST=https://us.i.posthog.com

# Any OpenAI-compatible endpoint. OpenRouter by default; the PostHog AI gateway also works.
LLM_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

APP_NAME=Hog Supply Co.
DATABASE_PATH=data/shop.db
